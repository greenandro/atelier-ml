{
  "name": "atelier-ml",
  "version": "1.0.0",
  "private": true,
  "description": "Racine de l'Atelier ML : lance l'API et le front ensemble.",
  "scripts": {
    "setup": "npm --prefix server install && npm --prefix web install",
    "dev": "concurrently -n api,web -c blue,magenta -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix server run dev",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm --prefix server start",
    "test": "node server/test-api.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
